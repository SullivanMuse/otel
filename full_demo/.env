frontend_host=localhost
frontend_port=8000
frontend_backend_host=localhost
frontend_backend_port=8001

backend_host=localhost
backend_port=8001
backend_power_supply_controller_host=localhost
backend_power_supply_controller_port=8002

power_supply_controller_port=8002
power_supply_controller_supply_port=8003

power_supply_sim_port=8003

# OTLP/HTTP collector. Read by the backend (via dotenvy) and baked into the frontend
# bundle by vite.config.ts; the browser sends to it directly, so it must be reachable
# from the browser's machine.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
